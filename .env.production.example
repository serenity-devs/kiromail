# Copia este archivo como .env en el servidor. No guardes secretos aquí.
APP_DOMAIN=mail.example.com
ADMIN_EMAIL=admin@example.com

# Vacío permite administrar transporte y región desde Ajustes.
MAIL_TRANSPORT=
AWS_REGION=

# ARN separados por comas. No es una credencial, pero limita los Topics aceptados.
SNS_TOPIC_ARNS=

CONTENT_STORAGE=
S3_BUCKET=
S3_PREFIX=serenity-mail
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

ALLOW_PRIVATE_WEBHOOKS=false
POSTGRES_SHM_SIZE=256mb
WORKER_CONCURRENCY=5
SEND_RATE_PER_SECOND=10
TRANSACTIONAL_WORKER_CONCURRENCY=4
TRANSACTIONAL_SEND_RATE_PER_SECOND=2
DATA_WORKER_CONCURRENCY=1

API_RATE_LIMIT_PER_MINUTE=600
SESSION_RATE_LIMIT_PER_MINUTE=900
PUBLIC_RATE_LIMIT_PER_MINUTE=30
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
