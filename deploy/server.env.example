# Configuración no secreta del despliegue alojado en el VPS de ValueStats.
APP_DOMAIN=kiromail.valuestats.com
ADMIN_EMAIL=admin@valuestats.com
PUBLIC_PROXY_NETWORK=valuebets_web

# Se completan al conectar Amazon SES. Vacíos permiten configurarlos desde la UI.
MAIL_TRANSPORT=
AWS_REGION=
SNS_TOPIC_ARNS=

CONTENT_STORAGE=filesystem
S3_BUCKET=
S3_PREFIX=kiromail
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
ALLOW_PRIVATE_WEBHOOKS=false

# Perfil conservador para el VPS actual de 2 GiB. Aumentar la RAM antes de
# incrementar concurrencia o trabajar de forma sostenida con 100.000 contactos.
POSTGRES_SHM_SIZE=128mb
POSTGRES_MEMORY_LIMIT=384m
REDIS_MEMORY_LIMIT=128m
APP_MEMORY_LIMIT=384m
WORKER_MEMORY_LIMIT=320m
MIGRATE_MEMORY_LIMIT=384m
BACKUP_MEMORY_LIMIT=384m
WORKER_CONCURRENCY=2
SEND_RATE_PER_SECOND=5
TRANSACTIONAL_WORKER_CONCURRENCY=2
TRANSACTIONAL_SEND_RATE_PER_SECOND=2
DATA_WORKER_CONCURRENCY=1

API_RATE_LIMIT_PER_MINUTE=600
SESSION_RATE_LIMIT_PER_MINUTE=900
PUBLIC_RATE_LIMIT_PER_MINUTE=30
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
