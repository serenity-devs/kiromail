APP_URL=http://localhost:3100
ADMIN_EMAIL=admin@serenity.local
ADMIN_PASSWORD=serenity-local-2026
SESSION_SECRET=cambia-este-secreto-largo

# Vacío: usa lo elegido en Ajustes (por defecto SMTP local → Mailpit).
# Usa smtp o ses solo si quieres fijarlo por entorno e impedir cambios desde la UI.
MAIL_TRANSPORT=

# Producción con Amazon SES
# Vacío: usa la región persistida en Ajustes. Un valor aquí actúa como override.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Blobs inmutables de HTML/texto exactos. En Docker se monta en /app/message-content.
CONTENT_STORAGE_DIR=/app/message-content
# Vacío: usa el ajuste persistido. Valores admitidos: filesystem o s3.
CONTENT_STORAGE=
S3_BUCKET=
S3_PREFIX=serenity-mail
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ARN(s) de SNS autorizados para eventos SES, separados por comas.
SNS_TOPIC_ARNS=
DATA_ENCRYPTION_KEY=cambia-esta-clave-de-cifrado-larga
ALLOW_PRIVATE_WEBHOOKS=false
TRUST_PROXY=false
API_RATE_LIMIT_PER_MINUTE=600
SESSION_RATE_LIMIT_PER_MINUTE=900
PUBLIC_RATE_LIMIT_PER_MINUTE=30
METRICS_TOKEN=
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5

# Copias cifradas del perfil Docker "ops".
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

WORKER_CONCURRENCY=5
SEND_RATE_PER_SECOND=10
TRANSACTIONAL_WORKER_CONCURRENCY=4
TRANSACTIONAL_SEND_RATE_PER_SECOND=2

# Cualquier secreto admite alternativamente NAME_FILE=/run/secrets/name,
# incluidas las credenciales AWS. Con un rol IAM, déjalas todas vacías.
# En producción usa docker-compose.production.yml y crea los archivos bajo ./secrets/.
